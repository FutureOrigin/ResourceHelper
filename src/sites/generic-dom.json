{
  "id": "generic-dom",
  "priority": 0,
  "match": [
    "*"
  ],
  "title": [
    "$doc.title"
  ],
  "titleCleanup": [
    "\\s*[-_—|]\\s*QQ音乐.*$",
    "\\s*[-_—|]\\s*网易云音乐.*$",
    "\\s*[-_—|]\\s*酷狗音乐.*$",
    "\\s*[-_—|]\\s*酷我音乐.*$",
    "\\s*[-_—|]\\s*哔哩哔哩.*$",
    "\\s*[-_—|]\\s*YouTube.*$",
    "\\s*[-_—|]\\s*腾讯视频.*$"
  ],
  "media": {
    "video": {
      "each": "$media[*]",
      "filter": "$.kind == 'video'",
      "url": "$.src",
      "width": "$.width",
      "height": "$.height",
      "container": "$.ext",
      "videoOnly": false
    },
    "audio": {
      "each": "$media[*]",
      "filter": "$.kind == 'audio'",
      "url": "$.src",
      "container": "$.ext"
    }
  }
}
