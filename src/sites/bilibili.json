{
  "id": "bilibili-video",
  "version": 1,
  "match": [
    "*.bilibili.com/video/*",
    "*.bilibili.com/list/*"
  ],
  "title": [
    "$.data.videoData.title",
    "$doc.title"
  ],
  "media": {
    "id": "$.data.bvid || $.bvid",
    "drm": "$.data.is_drm == 1",
    "video": {
      "each": "$.data.dash.video[*]",
      "url": "$.baseUrl || $.backupUrl[0]",
      "id": "$.id",
      "quality": "$.id",
      "width": "$.width",
      "height": "$.height",
      "bitrate": "$.bandwidth",
      "codec": "$.codecs",
      "videoOnly": true,
      "labels": {
        "16": "360P 流畅",
        "32": "480P 清晰",
        "64": "720P 高清",
        "74": "720P60",
        "80": "1080P 高清",
        "116": "1080P60",
        "120": "4K",
        "127": "8K"
      }
    },
    "audio": {
      "each": "$.data.dash.audio[*]",
      "url": "$.baseUrl || $.backupUrl[0]",
      "id": "$.id",
      "bitrate": "$.bandwidth",
      "quality": "$.id",
      "lang": "$.lang",
      "labels": {
        "30216": "64K 流畅",
        "30232": "132K 标准",
        "30250": "杜比全景声",
        "30251": "Hi-Res 无损",
        "30280": "192K 高保真"
      }
    }
  },
  "headers": {
    "Referer": "https://www.bilibili.com/"
  },
  "referer": "https://www.bilibili.com/",
  "priority": 10,
  "titleCleanup": [
    "\\s*[-_—|]\\s*哔哩哔哩.*$",
    "\\s*[-_—|]\\s*bilibili.*$",
    "\\s*[-_—|]\\s*YouTube.*$",
    "\\s*[-_—|]\\s*腾讯视频.*$",
    "\\s*[-_—|]\\s*QQ音乐.*$",
    "\\s*[-_—|]\\s*网易云音乐.*$"
  ]
}
